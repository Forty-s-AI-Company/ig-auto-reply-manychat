{
  "name": "inboxpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3041",
    "dev:ngrok": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev-ngrok.ps1",
    "build": "node scripts/prisma-generate-safe.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:auth": "npm run e2e:admin:ensure && playwright test tests/e2e/public-and-auth.spec.ts",
    "test:e2e:contacts": "npm run e2e:admin:ensure && playwright test tests/e2e/contacts-auth.spec.ts",
    "test:e2e:empty": "npm run e2e:empty:ensure && playwright test tests/e2e/empty-workspace-activation.spec.ts --workers=1",
    "test:e2e:inbox": "npm run e2e:admin:ensure && playwright test tests/e2e/inbox-auth.spec.ts --workers=1",
    "test:e2e:reviewer": "npm run e2e:reviewer:ensure && playwright test tests/e2e/meta-reviewer-rehearsal.spec.ts --workers=1",
    "test:e2e:simple": "node scripts/run-simple-release-e2e.mjs",
    "test:coverage": "vitest run tests/unit tests/integration --coverage",
    "test:coverage:db": "node scripts/run-tests.mjs --coverage",
    "load:test": "node scripts/load-test.mjs",
    "prisma:migrate": "node scripts/prisma-env.mjs db push",
    "prisma:push": "node scripts/prisma-env.mjs db push",
    "prisma:generate": "node scripts/prisma-env.mjs generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin:ensure": "tsx scripts/ensure-admin.ts",
    "e2e:admin:ensure": "tsx scripts/ensure-e2e-admin.ts",
    "e2e:empty:ensure": "tsx scripts/ensure-empty-e2e-admin.ts",
    "e2e:reviewer:ensure": "tsx scripts/ensure-reviewer-demo-data.ts",
    "data:import-legacy": "node scripts/import-legacy-sqlite.mjs",
    "payuni:smoke": "tsx scripts/payuni-smoke-test.mjs",
    "ai-models:refresh": "tsx scripts/refresh-ai-models.ts",
    "meta:refresh-token": "node scripts/refresh-meta-token.mjs",
    "worker": "tsx scripts/worker.ts",
    "ai-team": "python scripts/ai_release_autopilot.py --mode status",
    "ai-team:status": "python scripts/ai_release_autopilot.py --mode status",
    "ai-team:next": "python scripts/ai_release_autopilot.py --mode inventory",
    "ai-team:check": "python scripts/ai_release_autopilot.py --mode docs-check",
    "ai-team:dev": "python scripts/ai_release_autopilot.py --mode run-once --profile local-aggressive",
    "ai-team:qa": "python scripts/ai_release_autopilot.py --mode qa-only --profile local-aggressive",
    "ai-team:qa:lite": "python scripts/ai_release_autopilot.py --mode qa-only --profile local-aggressive",
    "ai-team:qa:full": "python scripts/ai_release_autopilot.py --mode qa-only --profile staging-aggressive",
    "ai-team:qa:strict": "python scripts/ai_release_autopilot.py --mode qa-only --profile staging-aggressive",
    "ai-team:browser-qa": "python scripts/ai_release_autopilot.py --mode qa-only --profile staging-aggressive",
    "ai-team:models": "python scripts/ai_cli_probe.py",
    "ai-team:models:general": "python scripts/ai_cli_probe.py",
    "ai-team:models:advanced": "python scripts/ai_cli_probe.py",
    "ai-team:models:sleep": "python scripts/ai_cli_probe.py",
    "ai-team:loop": "python scripts/ai_release_autopilot.py --mode run --profile local-aggressive --max-rounds 3",
    "ai-team:loop:general": "python scripts/ai_release_autopilot.py --mode run --profile local-aggressive --max-rounds 3",
    "ai-team:loop:advanced": "python scripts/ai_release_autopilot.py --mode run --profile local-aggressive --max-rounds 5",
    "ai-team:loop:sleep": "python scripts/ai_release_autopilot.py --mode run --profile staging-aggressive --max-rounds 10",
    "ai-team:loop:continuous": "python scripts/ai_release_autopilot.py --mode run --profile local-aggressive --max-rounds 10",
    "ai-team:loop:continuous:advanced": "python scripts/ai_release_autopilot.py --mode run --profile local-aggressive --max-rounds 10",
    "ai-team:loop:continuous:sleep": "python scripts/ai_release_autopilot.py --mode run --profile staging-aggressive --max-rounds 10",
    "ai-team:loop:once": "python scripts/ai_release_autopilot.py --mode run-once --profile local-aggressive",
    "ai-team:loop:once:advanced": "python scripts/ai_release_autopilot.py --mode run-once --profile local-aggressive",
    "ai-team:loop:once:sleep": "python scripts/ai_release_autopilot.py --mode run-once --profile staging-aggressive",
    "ai-team:loop:smoke": "python scripts/ai_release_autopilot.py --mode run-once --profile dry-run",
    "autopilot": "python scripts/ai_release_autopilot.py --mode run --profile local-aggressive --max-rounds 10",
    "reset-db": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.6",
    "ioredis": "^5.11.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "openai": "^6.38.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.1",
    "simple-icons": "^16.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.2",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
